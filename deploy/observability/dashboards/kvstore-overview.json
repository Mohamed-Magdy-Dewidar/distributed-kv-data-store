    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Client Puts served per second, summed over the pods that received them (kv-client spreads requests), by gRPC status code.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(kv_client_request_duration_seconds_count{job=\"kvstore\",method=\"Put\"}[1m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "title": "Put rate by status code",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Time to serve a client Put on the pod that received it, including forwarding to a replica and waiting for W acks. From kv_client_request_duration_seconds, all pods together.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kv_client_request_duration_seconds_bucket{job=\"kvstore\",method=\"Put\"}[1m])))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(kv_client_request_duration_seconds_bucket{job=\"kvstore\",method=\"Put\"}[1m])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "title": "Put latency p50 / p99",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Reads that did not reach R responses and writes that did not reach W acks, coordinated by any pod, over the last 5 minutes. From kv_quorum_failures_total.",
