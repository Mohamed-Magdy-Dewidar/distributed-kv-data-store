{
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "kv_membership_epoch: the epoch of the membership view each pod holds. After a membership change every pod should reach the new epoch.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter"
          },
          "decimals": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kv_membership_epoch{job=\"kvstore\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Membership epoch by pod",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Client Puts served per second, summed over the pods that received them (kv-client spreads requests), by gRPC status code.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(kv_client_request_duration_seconds_count{job=\"kvstore\",method=\"Put\"}[1m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "title": "Put rate by status code",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Time to serve a client Put on the pod that received it, including forwarding to a replica and waiting for W acks. From kv_client_request_duration_seconds, all pods together.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kv_client_request_duration_seconds_bucket{job=\"kvstore\",method=\"Put\"}[1m])))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(kv_client_request_duration_seconds_bucket{job=\"kvstore\",method=\"Put\"}[1m])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "title": "Put latency p50 / p99",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Time to fsync one write to the data engine's write-ahead log, all pods together. From kv_wal_fsync_duration_seconds{engine=\"data\"}; replay at startup is not included.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kv_wal_fsync_duration_seconds_bucket{job=\"kvstore\",engine=\"data\"}[1m])))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(kv_wal_fsync_duration_seconds_bucket{job=\"kvstore\",engine=\"data\"}[1m])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "title": "WAL fsync latency p50 / p99 (data engine)",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": [
    "kvstore"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "utc",
  "title": "kvstore overview",
  "uid": "kvstore-overview"
}
